# Example settings. Normally you do NOT copy this file: `python scripts/manage.py setup` creates .env for you with
# a random JWT secret and a random demo password. Comments are on their own lines on purpose: in .env files,
# text after "=" on the same line is read as the value.

# dev | prod
VANTAGE_ENV=dev
# seeds demo users and demo deals; refused when VANTAGE_ENV=prod
VANTAGE_DEMO_MODE=true
# random value of at least 32 characters (setup generates it; leave empty here)
VANTAGE_JWT_SECRET=
# demo accounts' password, demo mode only: 12+ characters with upper/lower case, a digit and a symbol (setup generates it)
VANTAGE_SEED_PASSWORD=
# true in production (HTTPS only)
VANTAGE_COOKIE_SECURE=false
# snapshot (stored SEC/GLEIF/FRED data, works offline) | live
VANTAGE_SOURCE_MODE=snapshot
# required for live SEC access, in the form: Your Name your@email.com
VANTAGE_SEC_USER_AGENT=
# offline | anthropic | openai
VANTAGE_LLM_PROVIDER=offline
VANTAGE_ANTHROPIC_API_KEY=
# PostgreSQL instead of SQLite:
# VANTAGE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/vantage

# Two-factor authentication (authenticator-app codes). Any user can turn it on under "Account security".
# Make it mandatory for these roles (JSON list):
# VANTAGE_MFA_REQUIRED_ROLES=["admin","partner"]
# Optional Fernet key for stored 2FA secrets (derived from the JWT secret if unset):
# VANTAGE_MFA_ENCRYPTION_KEY=
# Lifetime of an administrator-issued password-reset link, in minutes:
# VANTAGE_PASSWORD_RESET_MINUTES=30
