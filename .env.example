# Copy to .env (or run: python scripts/manage.py setup, which generates random secrets).
VANTAGE_ENV=dev                 # dev | prod
VANTAGE_DEMO_MODE=true          # seeds demo users + demo deals; refused when VANTAGE_ENV=prod
VANTAGE_JWT_SECRET=             REPLACE_WITH_A_LONG_RANDOM_LOCAL_SECRET
VANTAGE_SEED_PASSWORD=          REPLACE_WITH_A_UNIQUE_LOCAL_DEMO_PASSWORD
VANTAGE_COOKIE_SECURE=false     # true in production (HTTPS)
VANTAGE_SOURCE_MODE=snapshot    # snapshot | live
VANTAGE_SEC_USER_AGENT=         # "Your Name your@email.com" Ã¢â‚¬â€ required for live SEC access
VANTAGE_LLM_PROVIDER=offline    # offline | anthropic | openai
VANTAGE_ANTHROPIC_API_KEY=

# Two-factor authentication (authenticator-app codes). Any user can turn it on under "Account security".
# VANTAGE_MFA_REQUIRED_ROLES=["admin","partner"]   # make it mandatory for these roles (JSON list)
# VANTAGE_MFA_ENCRYPTION_KEY=                       # optional Fernet key for stored 2FA secrets; derived from the JWT secret if unset
# VANTAGE_PASSWORD_RESET_MINUTES=30                 # lifetime of an administrator-issued reset link
